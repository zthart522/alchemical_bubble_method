LAMMPS (30 Mar 2026 - Development - patch_30Mar2026-1074-g7f680de296)
  using 4 OpenMP thread(s) per MPI task

##############################################
###              Variables                 ###
##############################################

variable       T               equal      0.7
variable       T_damp          equal      1.0
variable       P               equal      1.0
variable       P_damp          equal      2.5
variable       seed            equal      1

variable       lambda_cross    equal      1.0
variable       lambda_bubble   equal      0.8500000000000001
variable       lambda_elec     equal      1.0

variable       iofrq           equal      100

##############################################
###           General Settings             ###
##############################################

units           lj
atom_style      full
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       equilibrated.data
