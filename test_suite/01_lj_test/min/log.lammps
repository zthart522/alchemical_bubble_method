##############################################
###           Model Definition             ###
##############################################

include         styles.lmp
pair_style lj/cut 2.5
include         params.lmp
pair_coeff 1 1 1 1.0 1.0
pair_coeff 1 2 1 1.0 1.0
pair_coeff 2 2 1 1.0 1.0


special_bonds   lj/coul 0.0 0.0 1.0
