##############################################
###           General Settings             ###
##############################################

units           lj
atom_style      full
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       packed.data
