
##############################################
###           General Settings             ###
##############################################

units           lj
atom_style      full
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       packed.data

##############################################
###           Model Definition             ###
##############################################

include         styles.lmp
include         params.lmp

special_bonds   lj/coul 0.0 0.0 1.0

##############################################
###       Dynamics / Minimization        ###
##############################################

thermo          100
thermo_style    custom step temp etotal econserve ke pe ebond eangle edihed press density vol
dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

min_style       cg
minimize        1e-07 1e-09 1000 500000
min_style       fire
min_modify      dmax 0.01
minimize        1e-07 1e-09 7000 500000

##############################################
###              Save Data               ###
##############################################

write_data   minimized.data nocoeff
