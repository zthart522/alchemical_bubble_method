
##############################################
###              Variables               ###
##############################################

variable       T               equal      6500.0
variable       T_damp          equal      20.0
variable       seed            equal      3454

##############################################
###           General Settings             ###
##############################################

units           real
atom_style      atomic
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       packed.data
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian

##############################################
###           Model Definition             ###
##############################################

include         styles.lmp
include         params.lmp

##############################################
###       Dynamics / Minimization          ###
##############################################

fix             1 all nvt temp ${T} ${T} ${T_damp}
thermo          100
thermo_style    custom step temp etotal econserve ke pe ebond eangle edihed press density vol
dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

variable        xdim equal lx
variable        ydim equal ly
variable        zdim equal lz
fix             boxlens all ave/time 1 20000 20000 v_xdim v_ydim v_zdim

timestep        0.25
run             40000

variable        avg_xdim equal f_boxlens[1]
variable        avg_ydim equal f_boxlens[2]
variable        avg_zdim equal f_boxlens[3]

change_box      all x final 0.0 ${avg_xdim} y final 0.0 ${avg_ydim} z final 0.0 ${avg_zdim} remap

##############################################
###            Save Datafile             ###
##############################################

write_data      equilibrated.data nocoeff
