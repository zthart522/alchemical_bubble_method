LAMMPS (29 Aug 2024 - Update 1)

##############################################
###              Variables               ###
##############################################

variable       T               equal      6500.0
variable       T_damp          equal      20.0
variable       seed            equal      3454

##############################################
###           General Settings             ###
##############################################

units           real
atom_style      atomic
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       packed.data
Reading data file ...
  orthogonal box = (0 0 0) to (7.906793 12.259056 12.259056)
  3 by 4 by 4 MPI processor grid
  reading atoms ...
  128 atoms
  read_data CPU = 0.015 seconds
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
velocity        all create 6500 ${seed} mom yes rot yes dist gaussian
velocity        all create 6500 3454 mom yes rot yes dist gaussian

##############################################
###           Model Definition             ###
##############################################

include         styles.lmp
pair_style chimesFF
include         params.lmp
pair_coeff 1 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 2 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 3 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 2 2 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 2 3 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 3 3 /scratch/11346/zthart/fuse_project/scaling_test/params.txt


##############################################
###       Dynamics / Minimization          ###
##############################################

fix             1 all nvt temp ${T} ${T} ${T_damp}
fix             1 all nvt temp 6500 ${T} ${T_damp}
fix             1 all nvt temp 6500 6500 ${T_damp}
fix             1 all nvt temp 6500 6500 20
thermo          100
thermo_style    custom step temp etotal econserve ke pe ebond eangle edihed press density vol
dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

variable        xdim equal lx
variable        ydim equal ly
variable        zdim equal lz
fix             boxlens all ave/time 1 20000 20000 v_xdim v_ydim v_zdim

timestep        0.25
run             40000

