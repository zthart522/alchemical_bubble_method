
##############################################
###              Variables                 ###
##############################################

variable       T               equal      6500.0
variable       T_damp          equal      20.0
variable       seed            equal      3454

variable       lambda_cross    equal      0.25
variable       lambda_bubble   equal      1.0

variable       iofrq           equal      100

##############################################
###           General Settings             ###
##############################################

units           real
atom_style      atomic
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       equilibrated.data

##############################################
###           Model Definition             ###
##############################################

include         ti_styles.lmp
include         ti_params.lmp

##############################################
###                Groups                ###
##############################################

group           solute   id 1
group           solvent  subtract all solute

##############################################
###       Dynamics / Minimization        ###
##############################################

compute			ps_0 all pair chimesFF 1
compute			ps_1 all pair chimesFF 2
variable		dUdL equal -c_ps_0+c_ps_1

fix             1 all nvt temp ${T} ${T} ${T_damp}
fix             dUdL_avg all ave/time 1 ${iofrq} ${iofrq} v_dUdL

thermo          ${iofrq}
thermo_style    custom step temp etotal econserve ke pe press density vol v_dUdL f_dUdL_avg

dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

timestep        0.25
run             40000

##############################################
###            Save Datafile             ###
##############################################

write_data      ti_cross_0.25000.data nocoeff
