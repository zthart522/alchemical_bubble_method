LAMMPS (29 Aug 2024 - Update 1)

##############################################
###              Variables                 ###
##############################################

variable       T               equal      6500.0
variable       T_damp          equal      20.0
variable       seed            equal      3454

variable       lambda_cross    equal      0.0
variable       lambda_bubble   equal      0.5

variable       iofrq           equal      100

##############################################
###           General Settings             ###
##############################################

units           real
atom_style      atomic
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       equilibrated.data
Reading data file ...
  orthogonal box = (0 0 0) to (7.906793 12.259056 12.259056)
  3 by 4 by 4 MPI processor grid
  reading atoms ...
  128 atoms
  reading velocities ...
  128 velocities
  read_data CPU = 0.014 seconds

##############################################
###           Model Definition             ###
##############################################

include         ti_styles.lmp
pair_style hybrid/scaled $(1.0-v_lambda_cross) chimesFF                          v_lambda_cross chimesFF                          v_lambda_bubble soft 2.0
pair_style hybrid/scaled 1 chimesFF                          v_lambda_cross chimesFF                          v_lambda_bubble soft 2.0
include         ti_params.lmp
pair_coeff 1 1 chimesFF 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 2 chimesFF 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 3 chimesFF 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 2 2 chimesFF 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 2 3 chimesFF 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 3 3 chimesFF 1 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 1 chimesFF 2 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 2 chimesFF 2 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 2 2 chimesFF 2 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 3 3 chimesFF 2 /scratch/11346/zthart/fuse_project/scaling_test/params.txt
pair_coeff 1 3 soft 100.0
pair_coeff 2 3 soft 100.0


##############################################
###                Groups                ###
##############################################

group           solute   id 1
1 atoms in group solute
group           solvent  subtract all solute
127 atoms in group solvent

##############################################
###       Dynamics / Minimization        ###
##############################################

compute			ps_0 all pair soft
variable		dUdL equal c_ps_0

fix             1 all nvt temp ${T} ${T} ${T_damp}
fix             1 all nvt temp 6500 ${T} ${T_damp}
fix             1 all nvt temp 6500 6500 ${T_damp}
fix             1 all nvt temp 6500 6500 20
fix             dUdL_avg all ave/time 1 ${iofrq} ${iofrq} v_dUdL
fix             dUdL_avg all ave/time 1 100 ${iofrq} v_dUdL
fix             dUdL_avg all ave/time 1 100 100 v_dUdL

thermo          ${iofrq}
thermo          100
thermo_style    custom step temp etotal econserve ke pe press density vol v_dUdL f_dUdL_avg

dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

timestep        0.25
run             40000

