
##############################################
###              Variables                 ###
##############################################

variable       T               equal      0.7
variable       T_damp          equal      1.0
variable       P               equal      1.0
variable       P_damp          equal      2.5
variable       seed            equal      3454

variable       lambda_cross    equal      1.0
variable       lambda_bubble   equal      0.4

variable       iofrq           equal      100

##############################################
###           General Settings             ###
##############################################

units           lj
atom_style      full
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       equilibrated.data

##############################################
###           Model Definition             ###
##############################################

include         ti_styles.lmp
include         ti_params.lmp

special_bonds   lj/coul 0.0 0.0 1.0

##############################################
###                Groups                ###
##############################################

group           solute   molecule 1
group           solvent  subtract all solute

##############################################
###       Dynamics / Minimization        ###
##############################################

compute			ps_0 all pair soft
variable		dUdL equal c_ps_0

fix             1 all npt temp ${T} ${T} ${T_damp} iso ${P} ${P} ${P_damp}
fix             dUdL_avg all ave/time 1 ${iofrq} ${iofrq} v_dUdL

thermo          ${iofrq}
thermo_style    custom step temp etotal econserve ke pe press density vol v_dUdL f_dUdL_avg

dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

timestep        0.005
run             25000

##############################################
###            Save Datafile             ###
##############################################

write_data      bubble_off_0.40000.data nocoeff
