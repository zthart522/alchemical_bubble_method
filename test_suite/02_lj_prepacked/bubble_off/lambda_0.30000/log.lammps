     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.008 seconds

##############################################
###           Model Definition             ###
##############################################

include         ti_styles.lmp
pair_style hybrid/scaled $(1.0-v_lambda_cross) lj/cut 2.5                          v_lambda_cross lj/cut 2.5                          v_lambda_bubble soft 1.05
pair_style hybrid/scaled 0 lj/cut 2.5                          v_lambda_cross lj/cut 2.5                          v_lambda_bubble soft 1.05
include         ti_params.lmp
pair_coeff 1 1 lj/cut 1 1.0 1.0
pair_coeff 1 2 lj/cut 1 1.0 1.0
pair_coeff 2 2 lj/cut 1 1.0 1.0
pair_coeff 1 1 lj/cut 2 1.0 1.0
pair_coeff 2 2 lj/cut 2 1.0 1.0
pair_coeff 1 2 soft 50.0


special_bonds   lj/coul 0.0 0.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        1       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.000 seconds

##############################################
###                Groups                ###
##############################################

group           solute   molecule 1
1 atoms in group solute
group           solvent  subtract all solute
1000 atoms in group solvent

##############################################
###       Dynamics / Minimization        ###
##############################################

compute			ps_0 all pair soft
variable		dUdL equal c_ps_0

fix             1 all npt temp ${T} ${T} ${T_damp} iso ${P} ${P} ${P_damp}
fix             1 all npt temp 0.7 ${T} ${T_damp} iso ${P} ${P} ${P_damp}
fix             1 all npt temp 0.7 0.7 ${T_damp} iso ${P} ${P} ${P_damp}
fix             1 all npt temp 0.7 0.7 1 iso ${P} ${P} ${P_damp}
fix             1 all npt temp 0.7 0.7 1 iso 1 ${P} ${P_damp}
fix             1 all npt temp 0.7 0.7 1 iso 1 1 ${P_damp}
fix             1 all npt temp 0.7 0.7 1 iso 1 1 2.5
fix             dUdL_avg all ave/time 1 ${iofrq} ${iofrq} v_dUdL
fix             dUdL_avg all ave/time 1 100 ${iofrq} v_dUdL
fix             dUdL_avg all ave/time 1 100 100 v_dUdL

thermo          ${iofrq}
thermo          100
thermo_style    custom step temp etotal econserve ke pe press density vol v_dUdL f_dUdL_avg

dump            1 all custom 1000 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

timestep        0.005
run             25000
