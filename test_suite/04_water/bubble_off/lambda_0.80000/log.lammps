##############################################
###           Model Definition             ###
##############################################

include         ti_styles.lmp
pair_style hybrid/scaled $(1.0-v_lambda_cross) lj/cut/kk 11.0                          $(1.0-v_lambda_cross) coul/wolf/kk 0.2 11.0                          v_lambda_cross coul/wolf/kk 0.2 11.0                          v_lambda_cross lj/cut/kk 11.0                          v_lambda_bubble soft 3.00
pair_style hybrid/scaled 0 lj/cut/kk 11.0                          $(1.0-v_lambda_cross) coul/wolf/kk 0.2 11.0                          v_lambda_cross coul/wolf/kk 0.2 11.0                          v_lambda_cross lj/cut/kk 11.0                          v_lambda_bubble soft 3.00
pair_style hybrid/scaled 0 lj/cut/kk 11.0                          0 coul/wolf/kk 0.2 11.0                          v_lambda_cross coul/wolf/kk 0.2 11.0                          v_lambda_cross lj/cut/kk 11.0                          v_lambda_bubble soft 3.00
bond_style harmonic
angle_style harmonic
include         ti_params.lmp
pair_coeff 1 1 coul/wolf/kk 1
pair_coeff 1 2 coul/wolf/kk 1
pair_coeff 1 3 coul/wolf/kk 1
pair_coeff 1 4 coul/wolf/kk 1
pair_coeff 2 2 coul/wolf/kk 1
pair_coeff 2 3 coul/wolf/kk 1
pair_coeff 2 4 coul/wolf/kk 1
pair_coeff 3 3 coul/wolf/kk 1
pair_coeff 3 4 coul/wolf/kk 1
pair_coeff 4 4 coul/wolf/kk 1
pair_coeff 1 1 coul/wolf/kk 2
pair_coeff 1 2 coul/wolf/kk 2
pair_coeff 2 2 coul/wolf/kk 2
pair_coeff 3 3 coul/wolf/kk 2
pair_coeff 3 4 coul/wolf/kk 2
pair_coeff 4 4 coul/wolf/kk 2
pair_coeff 1 1 lj/cut/kk 1 0.10200000 3.18800000
pair_coeff 1 2 lj/cut/kk 1 0.00000000 1.78549713
pair_coeff 1 3 lj/cut/kk 1 0.10200000 3.18800000
pair_coeff 1 4 lj/cut/kk 1 0.00000000 1.78549713
pair_coeff 2 2 lj/cut/kk 1 0.00000000 1.00000000
pair_coeff 2 3 lj/cut/kk 1 0.00000000 1.78549713
pair_coeff 2 4 lj/cut/kk 1 0.00000000 1.00000000
pair_coeff 3 3 lj/cut/kk 1 0.10200000 3.18800000
pair_coeff 3 4 lj/cut/kk 1 0.00000000 1.78549713
pair_coeff 4 4 lj/cut/kk 1 0.00000000 1.00000000
pair_coeff 1 1 lj/cut/kk 2 0.10200000 3.18800000
pair_coeff 1 2 lj/cut/kk 2 0.00000000 1.78549713
pair_coeff 2 2 lj/cut/kk 2 0.00000000 1.00000000
pair_coeff 3 3 lj/cut/kk 2 0.10200000 3.18800000
pair_coeff 3 4 lj/cut/kk 2 0.00000000 1.78549713
pair_coeff 4 4 lj/cut/kk 2 0.00000000 1.00000000
pair_coeff 1 3 soft 59.22
pair_coeff 1 4 soft 59.22
pair_coeff 2 3 soft 59.22
pair_coeff 2 4 soft 59.22

bond_coeff 1 450.000 0.957

angle_coeff 1 55.000 104.520


##############################################
###                Groups                ###
##############################################

group           solute   molecule 1
3 atoms in group solute
group           solvent  subtract all solute
1500 atoms in group solvent

##############################################
###       Dynamics / Minimization        ###
##############################################

compute			ps_0 all pair soft
variable		dUdL equal c_ps_0

fix             1 all npt temp ${T} ${T} ${T_damp} iso ${P} ${P} ${P_damp}
fix             1 all npt temp 298 ${T} ${T_damp} iso ${P} ${P} ${P_damp}
fix             1 all npt temp 298 298 ${T_damp} iso ${P} ${P} ${P_damp}
fix             1 all npt temp 298 298 100 iso ${P} ${P} ${P_damp}
fix             1 all npt temp 298 298 100 iso 1 ${P} ${P_damp}
fix             1 all npt temp 298 298 100 iso 1 1 ${P_damp}
fix             1 all npt temp 298 298 100 iso 1 1 250
fix             dUdL_avg all ave/time 1 ${iofrq} ${iofrq} v_dUdL
fix             dUdL_avg all ave/time 1 100 ${iofrq} v_dUdL
fix             dUdL_avg all ave/time 1 100 100 v_dUdL

thermo          ${iofrq}
thermo          100
thermo_style    custom step temp etotal econserve ke pe press density vol v_dUdL f_dUdL_avg

dump            1 all custom  ${iofrq} traj.lammpstrj id type xu yu zu
dump            1 all custom  100 traj.lammpstrj id type xu yu zu
dump_modify     1 sort id

timestep        0.5
run             10000

