pair_style hybrid/overlay/kk lj/cut/kk 11.0                              coul/wolf/kk 0.2 11.0
bond_style harmonic
angle_style harmonic
include         params.lmp
pair_coeff 1 1 coul/wolf/kk
pair_coeff 1 2 coul/wolf/kk
pair_coeff 1 3 coul/wolf/kk
pair_coeff 1 4 coul/wolf/kk
pair_coeff 2 2 coul/wolf/kk
