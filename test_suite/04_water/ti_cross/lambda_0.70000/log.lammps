  using 1 OpenMP thread(s) per MPI task
package kokkos

##############################################
###              Variables                 ###
##############################################

variable       T               equal      298.0
variable       T_damp          equal      100.0
variable       P               equal      1.0
variable       P_damp          equal      250.0
variable       seed            equal      3454

variable       lambda_cross    equal      0.7000000000000001
variable       lambda_bubble   equal      1.0

variable       iofrq           equal      100

##############################################
###           General Settings             ###
##############################################

units           real
atom_style      full
boundary        p p p
kspace_style    none
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

##############################################
###              Read Data                 ###
##############################################

read_data       equilibrated.data
